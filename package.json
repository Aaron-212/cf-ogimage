{
  "name": "cf-ogimage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var IMAGE_CACHE_ENABLED:false",
    "deploy": "wrangler deploy",
    "preview": "wrangler preview",
    "format": "oxfmt --write .",
