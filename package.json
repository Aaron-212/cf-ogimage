  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "csstype": "^3.2.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
